# TaoSentinel — every Settings key with its default (spec 01 §5; 627 keys incl. the read-only SCORING_SPEC_VERSION).
# Copy the lines you want to change into .env. Lists are JSON (e.g. WATCHLIST_NETUIDS=[64,51]).
# Secrets (*_TOKEN, *_KEY, *_SECRET, *_PAT, DEADMAN_PING_URL) are masked in logs, /health and `app check -v`.
# Comments sit on their own line: python-dotenv would read `KEY=  # note` as the value '# note'.

# ══ Runtime, alerts transport, shared providers (01) ══════════════════════════════════════════
# str — frozen scoring version; must be a key of 12's `SPECS` (`spec_unknown` otherwise)
SPEC_VERSION=ts-1.0
# str — upper-cased ∈ {DEBUG, INFO, WARNING, ERROR, CRITICAL} (old `config.py:637-644`)
LOG_LEVEL=INFO
# bool — master §11
LOG_RETENTION_ENABLED=true
# int — master §11
LOG_RETENTION_DAYS=14
# path — resolved against `APP_ROOT`
JSONL_DIR=data/logs
# path — resolved against `APP_ROOT`
DATA_DIR=data
# path — resolved against `APP_ROOT`
SEED_DIR=seed
# path — 03 uses them
DB_PATH=data/taosentinel.db
# int — 03 uses them
DB_BUSY_TIMEOUT_MS=5000
# str — alias `API_HOST` (14/15); warn when non-loopback and `API_AUTH_TOKEN` empty (old `main.py` 3258-3265)
HEALTH_HOST=127.0.0.1
# int — alias `API_PORT`; 1024–65535 (0 = pick a free port, tests only)
HEALTH_PORT=8090
# str — secret; empty = auth off (I2: set before any `tailscale serve`)
API_AUTH_TOKEN=
# str — comma list; validator rejects `*` (14)
CONTROL_ALLOWED_ORIGINS=http://localhost:3001,http://127.0.0.1:3001
# path — B12 closed sentinel list (with 16's `PAUSE_ALL_PATH`)
KILL_SWITCH_PATH=./KILL_SWITCH
# path — B12 closed sentinel list (with 16's `PAUSE_ALL_PATH`)
SCORING_KILL_SWITCH_PATH=./SCORING_KILLED
# bool — old `config.py:578`
SYSTEMD_WATCHDOG_ENABLED=true
# float — validator `DB + HTTP + 2 ≤ DEADLINE < 30` (unit `TimeoutStopSec=30`)
SHUTDOWN_DB_TIMEOUT_SEC=5.0
# float — validator `DB + HTTP + 2 ≤ DEADLINE < 30` (unit `TimeoutStopSec=30`)
SHUTDOWN_HTTP_TIMEOUT_SEC=3.0
# float — validator `DB + HTTP + 2 ≤ DEADLINE < 30` (unit `TimeoutStopSec=30`)
SHUTDOWN_DEADLINE_SEC=10.0
# str — operator edits
HTTP_USER_AGENT="TaoSentinel/0.1 (+https://github.com/<operator>/taosentinel)"
# float — `Http` defaults
HTTP_TIMEOUT_SEC=20.0
# int — `Http` defaults
HTTP_MAX_RETRIES=2
# int — default `max_body_bytes` of `Http.request` (§2.12)
HTTP_MAX_BODY_BYTES=5242880
# int — master §9 "collector failing ×5"
JOB_FAIL_ALERT_THRESHOLD=5
# int — master §9 "collector failing ×5"
JOB_DEFAULT_TIMEOUT_SEC=1800
# int — §2.7
JOB_START_STAGGER_SEC=20
# int — §2.7
STARTUP_CATCHUP_DELAY_SEC=300
# bool — ops interval jobs first fire at boot + 5 s instead of + 30 s
STARTUP_PRIME_ENABLED=true
# int — re-fire a still-latched `AlertLatch` key
ALERT_REPEAT_MIN=360
# float — `disk_low` (16 adds `DISK_FREE_CRITICAL_GB`)
DISK_FREE_MIN_GB=2.0
# str — secret token; checklist B3
TELEGRAM_BOT_TOKEN=
# str — secret token; checklist B3
TELEGRAM_CHAT_ID=
# bool — 14's `telegram_bot`; empty list → only `TELEGRAM_CHAT_ID`
TELEGRAM_COMMANDS_ENABLED=true
# str — 14's `telegram_bot`; empty list → only `TELEGRAM_CHAT_ID`
TELEGRAM_ALLOWED_CHAT_IDS=
# bool — old `config.py:542-547`; pipeline is 16's
DB_BACKUP_ENABLED=true
# path — old `config.py:542-547`; pipeline is 16's
DB_BACKUP_DIR=data/backups
# str — old `config.py:542-547`; pipeline is 16's
DB_BACKUP_MIRROR_DIR=
# int — I1
DB_BACKUP_RETENTION=7
# int — I1
DB_BACKUP_WEEKLY_RETENTION=8
# int — staleness math / startup-backup guard (16)
DB_BACKUP_INTERVAL_HOURS=24
# float — staleness math / startup-backup guard (16)
DB_BACKUP_MIN_AGE_HOURS=12.0
# float — shared (04)
BLOCK_SECONDS=12.0
# float — limiter rows (04 marks them shared, 01)
SUBTENSOR_RPC_RATE_PER_SEC=2.0
# float — limiter rows (04 marks them shared, 01)
SUBNETALPHA_RATE_PER_SEC=1.0
# str — checklist B2; keyed URL form UNVERIFIED (17)
ONFINALITY_API_KEY=
# str — checklist B2; keyed URL form UNVERIFIED (17)
ONFINALITY_WS_URL=wss://bittensor-finney.api.onfinality.io/public-ws
# float — clamped to 4.0 without a key (public 5 rps)
ONFINALITY_RATE_PER_SEC=20.0
# str (secret) — Blockmachine archive RPC key (17, primary backfill endpoint; plan: 1,000 req/min, 5 M RU/month)
BLOCKMACHINE_API_KEY=
# str — the key is sent as ?authorization=
BLOCKMACHINE_WS_URL=wss://rpc.blockmachine.io
# float — 0.1..16 (plan: 1,000 req/min)
BLOCKMACHINE_RATE_PER_SEC=12.0
# int — requests per UTC month (1 RU per call; 0 = disabled, 02 §F2)
BLOCKMACHINE_MONTHLY_CAP_REQ=4500000
# bool — checklist C3; 11 reads them
TAOSTATS_ENABLED=false
# str — checklist C3; 11 reads them
TAOSTATS_API_KEY=
# str — checklist C3; 11 reads them
TAOSTATS_BASE_URL=https://api.taostats.io
# int — free plan 5/min, 10 k/month (operator plan, 02 §F2)
TAOSTATS_RATE_PER_MIN=5
# int — F2; deprecated alias `TAOSTATS_MONTHLY_CALL_CAP`; 0 = disabled
TAOSTATS_MONTHLY_CAP_REQ=10000
# float — display only (flat subscription, 16)
TAOSTATS_MONTHLY_CAP_USD=0.0
# str — reserved (checklist C5)
TAOAPP_API_KEY=

